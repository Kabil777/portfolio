{
  "name": "kabil-ops-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:import-blog": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/import-blog.mjs",
    "admin:keygen": "node scripts/generate-admin-key.mjs",
    "test": "npm run test:blog && npm run test:platform",
    "test:platform": "tsx --test --test-concurrency=1 lib/platform.test.ts",
    "test:blog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test lib/blog.test.ts"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "class-variance-authority": "latest",
    "cn": "^0.2.5",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.45.0",
    "next": "latest",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "tailwindcss": "latest",
    "tsx": "^4.23.13",
    "typescript": "latest"
  },
  "packageManager": "npm@12.0.2"
}
